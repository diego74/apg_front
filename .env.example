# Supabase project URL and Publishable key. Both are safe for browser use.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# PostgreSQL connection string for server-side routes only. Use the Supabase
# transaction pooler URL in Vercel, never expose this value to the browser.
DATABASE_URL=
DATABASE_SSL=false
# Server-only. Copy the current `sb_secret_...` key from Supabase. Never use a
# NEXT_PUBLIC_ prefix or commit it. Required for /api/admin/uploads.
SUPABASE_SECRET_KEY=
# Required in production; use a random secret of at least 32 characters.
SESSION_SECRET=
# Used by `npm run db:seed-admin`.
ADMIN_EMAIL=admin@apg.pe
ADMIN_PASSWORD=change-this-password
